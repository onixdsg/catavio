---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { formatPrice, getProducts, buildCategoryMap } from '../../lib/shop';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((p) => ({
    params: { slug: p.id },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const {
  title,
  categoria,
  subcategoria = 'General',
  precio,
  destacado,
  stock,
  imagen,
  galeria = [],
  descripcion = '',
} = product.data;

const { Content } = await render(product);

const cats = await buildCategoryMap();
const categoriaNombre = cats.get(categoria) ?? categoria;

const relacionados = (await getProducts())
  .filter((p) => p.id !== product.id && p.data.categoria === categoria)
  .slice(0, 4);

const imagenes = [imagen, ...galeria.filter((g) => g !== imagen)];
---

<BaseLayout
  title={`${title} | Tienda`}
  description={descripcion || `${title} — ${formatPrice(precio)}`}
>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <!-- Breadcrumb -->
    <nav class="text-sm text-slate-500 mb-6 overflow-x-auto whitespace-nowrap" aria-label="breadcrumb">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-brand-600">Inicio</a></li>
        <li><span class="text-slate-300">/</span></li>
        <li><a href="/productos/" class="hover:text-brand-600">Productos</a></li>
        <li><span class="text-slate-300">/</span></li>
        <li><a href={`/productos/?categoria=${categoria}`} class="hover:text-brand-600">{categoriaNombre}</a></li>
        <li><span class="text-slate-300">/</span></li>
        <li aria-current="page" class="text-slate-700 font-medium">{title}</li>
      </ol>
    </nav>

    <div class="grid lg:grid-cols-2 gap-10">
      <!-- Galería -->
      <div>
        <div class="relative aspect-square rounded-3xl overflow-hidden bg-slate-100 border border-slate-200">
          <img
            data-gallery-main
            src={imagenes[0]}
            alt={title}
            class="w-full h-full object-cover"
          />
          {
            destacado && (
              <span class="absolute top-4 left-4 bg-amber-400 text-amber-900 text-xs font-bold px-2.5 py-1 rounded-full shadow">
                Destacado
              </span>
            )
          }
          {
            stock === 'sin_stock' && (
              <span class="absolute top-4 right-4 bg-slate-900/80 text-white text-xs font-semibold px-2.5 py-1 rounded-full">
                Sin stock
              </span>
            )
          }
        </div>
        {
          imagenes.length > 1 && (
            <div class="mt-4 flex gap-3 overflow-x-auto pb-1" data-gallery-thumbs>
              {
                imagenes.map((img, i) => (
                  <button
                    type="button"
                    data-gallery-thumb
                    data-src={img}
                    class:list={[
                      'shrink-0 w-20 h-20 rounded-xl overflow-hidden border-2 transition',
                      i === 0 ? 'border-brand-600' : 'border-slate-200 hover:border-slate-400',
                    ]}
                    aria-label={`Foto ${i + 1}`}
                  >
                    <img src={img} alt={`${title} foto ${i + 1}`} class="w-full h-full object-cover" loading="lazy" />
                  </button>
                ))
              }
            </div>
          )
        }
      </div>

      <!-- Información -->
      <div>
        <p class="text-xs uppercase tracking-wide text-slate-400 font-medium">
          {categoriaNombre}{subcategoria ? ` · ${subcategoria}` : ''}
        </p>
        <h1 class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">{title}</h1>

        <p class="mt-4 text-3xl font-extrabold text-brand-700">{formatPrice(precio)}</p>

        {
          descripcion && <p class="mt-4 text-slate-600 leading-relaxed">{descripcion}</p>
        }

        <div class="mt-6 space-y-4">
          <div>
            <label for="cantidad" class="block text-sm font-medium text-slate-700 mb-1.5">Cantidad</label>
            <div class="flex items-center gap-2">
              <button
                type="button"
                data-qty-detail
                data-action="dec"
                class="w-10 h-10 rounded-lg border border-slate-300 hover:bg-slate-100 text-lg"
                aria-label="Restar cantidad"
              >
                −
              </button>
              <input
                id="cantidad"
                type="number"
                data-qty-detail-input
                value="1"
                min="1"
                max="999"
                class="w-20 h-10 text-center border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500"
              />
              <button
                type="button"
                data-qty-detail
                data-action="inc"
                class="w-10 h-10 rounded-lg border border-slate-300 hover:bg-slate-100 text-lg"
                aria-label="Sumar cantidad"
              >
                +
              </button>
            </div>
          </div>

          {
            stock === 'sin_stock' ? (
              <div class="px-4 py-3 rounded-lg bg-slate-100 text-slate-500 font-medium text-center">
                Producto sin stock
              </div>
            ) : (
              <div class="grid sm:grid-cols-2 gap-3">
                <button
                  type="button"
                  data-add-detail
                  data-slug={product.id}
                  data-title={title}
                  data-precio={String(precio)}
                  data-imagen={imagen}
                  class="px-6 py-3.5 rounded-lg bg-brand-600 hover:bg-brand-700 text-white font-semibold transition active:scale-[.98]"
                >
                  Agregar al carrito
                </button>
                <button
                  type="button"
                  data-buy-detail
                  data-slug={product.id}
                  data-title={title}
                  data-precio={String(precio)}
                  data-imagen={imagen}
                  class="px-6 py-3.5 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-white font-semibold transition active:scale-[.98] flex items-center justify-center gap-2"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.04 2a9.9 9.9 0 00-8.43 15.06L2 22l5.08-1.57A9.92 9.92 0 1012.04 2z" />
                  </svg>
                  Comprar por WhatsApp
                </button>
              </div>
            )
          }

          <p class="text-sm text-slate-500 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Pago y envío se coordinan por WhatsApp al confirmar tu pedido.
          </p>
        </div>
      </div>
    </div>

    <!-- Descripción ampliada -->
    <div class="mt-14 grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 prose max-w-none">
        <h2 class="text-xl font-extrabold text-slate-900 mb-4">Descripción</h2>
        <div class="content">
          <Content />
        </div>
      </div>
      <aside class="lg:col-span-1">
        <div class="bg-slate-50 border border-slate-100 rounded-2xl p-6 sticky top-20 space-y-3">
          <h3 class="font-bold text-slate-900">¿Necesitás ayuda?</h3>
          <p class="text-sm text-slate-600">
            Escribinos y te asesoramos sobre este producto, stock y formas de pago.
          </p>
          <a
            href="/contacto/"
            class="block text-center px-4 py-2.5 rounded-lg border border-brand-600 text-brand-600 font-medium text-sm hover:bg-brand-50 transition"
          >
            Contactar
          </a>
        </div>
      </aside>
    </div>

    <!-- Relacionados -->
    {
      relacionados.length > 0 && (
        <section class="mt-16">
          <h2 class="text-2xl font-extrabold text-slate-900 mb-6">Productos relacionados</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {
              relacionados.map((p) => (
                <ProductCard
                  title={p.data.title}
                  slug={p.id}
                  precio={p.data.precio}
                  imagen={p.data.imagen}
                  categoria={cats.get(p.data.categoria) ?? p.data.categoria}
                  subcategoria={p.data.subcategoria}
                  destacado={p.data.destacado}
                  stock={p.data.stock}
                />
              ))
            }
          </div>
        </section>
      )
    }
  </section>

  <script is:inline define:vars={{ imagenes }}>
    window.PRODUCT_GALERY = imagenes;
  </script>

  <script>
    const main = document.querySelector<HTMLImageElement>('[data-gallery-main]');
    document
      .querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]')
      .forEach((thumb) => {
        thumb.addEventListener('click', () => {
          if (!main) return;
          main.src = thumb.dataset.src ?? main.src;
          document
            .querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]')
            .forEach((t) => {
              t.classList.toggle('border-brand-600', t === thumb);
              t.classList.toggle('border-slate-200', t !== thumb);
            });
        });
      });
  </script>

  <script>
    import { add, checkoutWhatsApp } from '../../scripts/cart';

    const input = document.querySelector<HTMLInputElement>(
      '[data-qty-detail-input]'
    );
    const qtyValue = () =>
      Math.max(1, Math.min(999, Number(input?.value || 1)));

    document
      .querySelectorAll<HTMLButtonElement>('[data-qty-detail]')
      .forEach((btn) => {
        btn.addEventListener('click', () => {
          if (!input) return;
          const n = qtyValue();
          input.value = String(
            btn.dataset.action === 'inc' ? n + 1 : n - 1
          );
        });
      });

    input?.addEventListener('change', () => {
      if (input) input.value = String(qtyValue());
    });

    const pushToCart = (btn: HTMLElement, openWa = false) => {
      const n = qtyValue();
      for (let i = 0; i < n; i++) {
        add(btn.dataset.slug ?? '', {
          title: btn.dataset.title ?? '',
          precio: Number(btn.dataset.precio || 0),
          imagen: btn.dataset.imagen || '',
        });
      }
      if (openWa) setTimeout(checkoutWhatsApp, 250);
    };

    document
      .querySelector('[data-add-detail]')
      ?.addEventListener('click', (e) =>
        pushToCart(e.currentTarget as HTMLElement, false)
      );
    document
      .querySelector('[data-buy-detail]')
      ?.addEventListener('click', (e) =>
        pushToCart(e.currentTarget as HTMLElement, true)
      );
  </script>
</BaseLayout>