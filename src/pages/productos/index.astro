---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { productIndex } from '../../lib/shop';

const index = await productIndex();
const initial = index.slice(0, 12);
---

<BaseLayout
  title="Productos | Tienda"
  description="Explorá nuestro catálogo completo. Filtrá por categoría, subcategoría, precio y más."
>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-8">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-white">Nuestros productos</h1>
        <p class="text-slate-400 mt-1" data-catalog-count>
          {index.length} productos
        </p>
      </div>
    </div>

    <!-- Búsqueda + filtros -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 mb-8 space-y-4">
      <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="search"
            data-filter="search"
            placeholder="Buscar producto..."
            class="w-full pl-10 pr-4 py-2.5 border border-slate-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-sm bg-slate-950 text-white placeholder-slate-500"
          />
        </div>
        <select
          data-filter="category"
          data-filter-category
          data-filter
          class="w-full sm:w-56 px-3 py-2.5 border border-slate-700 rounded-lg text-sm bg-slate-950 text-white focus:outline-none focus:ring-2 focus:ring-brand-500"
        >
          <option value="all">Todas las categorías</option>
        </select>
        <select
          data-filter="subcategory"
          data-filter-subcategory
          data-filter
          class="w-full sm:w-56 px-3 py-2.5 border border-slate-700 rounded-lg text-sm bg-slate-950 text-white focus:outline-none focus:ring-2 focus:ring-brand-500"
        >
          <option value="all">Todas las subcategorías</option>
        </select>
        <select
          data-filter="sort"
          data-filter
          class="w-full sm:w-48 px-3 py-2.5 border border-slate-700 rounded-lg text-sm bg-slate-950 text-white focus:outline-none focus:ring-2 focus:ring-brand-500"
        >
          <option value="recomendados">Ordenar: destacados</option>
          <option value="precio-asc">Precio: menor a mayor</option>
          <option value="precio-desc">Precio: mayor a menor</option>
          <option value="nombre">Nombre: A → Z</option>
        </select>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
        <div class="flex items-center gap-2 text-sm text-slate-400">
          <span class="font-medium text-slate-500">Precio:</span>
          <input
            type="number"
            data-filter="min"
            data-filter
            placeholder="Mín"
            class="w-24 px-3 py-2 border border-slate-700 bg-slate-950 text-white rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"
          />
          <span class="text-slate-600">—</span>
          <input
            type="number"
            data-filter="max"
            data-filter
            placeholder="Máx"
            class="w-24 px-3 py-2 border border-slate-700 bg-slate-950 text-white rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"
          />
        </div>
        <button
          type="button"
          data-filter-reset
          class="sm:ml-auto px-4 py-2 rounded-lg border border-slate-700 text-sm font-medium text-slate-300 hover:bg-slate-800 transition"
        >
          Limpiar filtros
        </button>
      </div>
    </div>

    <!-- Empty state -->
    <div data-catalog-empty class="hidden text-center py-16 bg-slate-900 rounded-2xl border border-slate-800 mb-8">
      <p class="text-3xl mb-2">🔍</p>
      <p class="text-lg font-semibold text-white">No encontramos productos</p>
      <p class="text-slate-400 mt-1">Probá con otros filtros o limpiá la búsqueda.</p>
    </div>

    <!-- Grid -->
    <div
      data-catalog-grid
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
    >
      {
        initial.map((p) => (
          <ProductCard
            title={p.title}
            slug={p.slug}
            precio={p.precio}
            imagen={p.imagen}
            categoria={p.categoryName}
            subcategoria={p.subcategoria}
            destacado={p.destacado}
            stock={p.stock}
          />
        ))
      }
    </div>

    <!-- Cargar más -->
    <div class="mt-10 text-center" data-catalog-more hidden>
      <button
        type="button"
        data-catalog-load
        class="px-8 py-3 rounded-lg border border-brand-600 text-brand-400 font-semibold hover:bg-brand-600/10 transition"
      >
        Cargar más
        <span class="text-brand-500" data-catalog-remaining>0</span> productos
      </button>
    </div>
  </section>

  <script is:inline define:vars={{ index }}>
    window.PRODUCTS = index;
  </script>
  <script>
    import { initCatalog } from '../../scripts/catalog';
    import { renderCart } from '../../scripts/cart';

    initCatalog();
    renderCart();
  </script>
</BaseLayout>