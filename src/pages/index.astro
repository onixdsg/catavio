---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts, formatPrice, buildCategoryMap } from '../lib/shop';
import shop from '../data/shop.json';

const sobreTitulo = shop.sobre_titulo || 'Sobre Catavio Sport';
const sobreTextos =
  shop.sobre_textos?.length > 0
    ? shop.sobre_textos
    : [
        'Somos una tienda de artículos deportivos de Villa María, Córdoba. Trabajamos con las mejores marcas para que encuentres ropa, calzado y accesorios para tu disciplina, sea fútbol, running, gimnasio o vida al aire libre.',
        'Te asesoramos a la hora de elegir, atendemos tu pedido por WhatsApp y coordinamos entrega como prefieras. Tu próxima marca personal arranca acá.',
      ];
const sobreItems =
  shop.sobre_items?.length > 0
    ? shop.sobre_items
    : [
        'Marcas de equipamiento deportivo',
        'Atención personalizada y asesoramiento',
        'Envíos y coordinación por WhatsApp',
      ];

const products = await getProducts();
const destacados = products.filter((p) => p.data.destacado);
const featured = destacados.length > 0 ? destacados : [products[0]];

const featuredIds = new Set(featured.map((p) => p.id));
const otros = products
  .filter((p) => !featuredIds.has(p.id))
  .slice(0, 4);

const cats = await buildCategoryMap();
---


<BaseLayout title="Inicio | Tienda">

<!-- HERO -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-700 via-brand-800 to-black">
    <img
      src="/images/logo.webp"
      alt=""
      aria-hidden="true"
      class="pointer-events-none select-none absolute left-0 inset-y-0 w-1/2 object-fill opacity-10 z-0"
    />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16 lg:py-20 relative z-10">
      <div class="grid" data-hero-carousel>
        {
          featured.map((p, i) => (
            <div
              data-hero-slide
              class:list={[
                'col-start-1 row-start-1 grid lg:grid-cols-2 gap-10 items-center transition-opacity duration-500',
                i === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none',
              ]}
              aria-hidden={i !== 0}
              inert={i !== 0}
            >
              <div>
                <p class="inline-flex items-center gap-2 bg-white/10 rounded-full px-3 py-1 text-sm font-medium mb-4">
                  Producto destacado de la semana
                </p>
                <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-tight">
                  {p.data.title}
                </h1>
                <p class="mt-4 text-lg text-white/70 max-w-xl">
                  {p.data.descripcion}
                </p>
                <p class="mt-6 text-3xl font-extrabold">{formatPrice(p.data.precio)}</p>
                <div class="mt-8 flex flex-wrap gap-3">
                  <a
                    href={`/productos/${p.id}/`}
                    class="px-6 py-3 rounded-lg bg-white text-slate-900 font-semibold hover:bg-slate-100 transition"
                  >
                    Ver producto
                  </a>
                  <button
                    type="button"
                    data-add-to-cart
                    data-slug={p.id}
                    data-title={p.data.title}
                    data-precio={String(p.data.precio)}
                    data-imagen={p.data.imagen}
                    class="px-6 py-3 rounded-lg bg-amber-400 text-amber-900 font-semibold hover:bg-amber-300 transition"
                  >
                    Agregar al carrito
                  </button>
                </div>
              </div>
              <div class="relative">
                <img
                  src={p.data.imagen}
                  alt={p.data.title}
                  class="w-full aspect-square object-cover rounded-3xl shadow-2xl ring-1 ring-white/20"
                />
              </div>
            </div>
          ))
        }
      </div>

      {
        featured.length > 1 && (
          <div class="mt-8 flex items-center justify-center gap-5">
            <button
              type="button"
              data-hero-prev
              class="w-10 h-10 grid place-items-center rounded-full bg-white/30 text-white hover:bg-white/40 transition"
              aria-label="Producto anterior"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6" />
              </svg>
            </button>

            <div class="flex items-center gap-2">
              {
                featured.map((_, i) => (
                  <button
                    type="button"
                    data-hero-dot
                    data-target={i}
                    class:list={[
                      'w-2.5 h-2.5 rounded-full transition',
                      i === 0 ? 'bg-white' : 'bg-white/40 hover:bg-white/70',
                    ]}
                    aria-label={`Ir al destacado ${i + 1}`}
                  ></button>
                ))
              }
            </div>

            <button
              type="button"
              data-hero-next
              class="w-10 h-10 grid place-items-center rounded-full bg-white/30 text-white hover:bg-white/40 transition"
              aria-label="Producto siguiente"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6" />
              </svg>
            </button>
          </div>
        )
      }
    </div>
  </section>

  <!-- CARACTERÍSTICAS -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-14">
    <div class="grid sm:grid-cols-3 gap-6">
      {
        [
          {
            t: 'Catálogo completo',
            d: 'Filtralo por categoría, subcategoría o precio y encontrá lo que buscás en segundos.',
            i: 'M7 21V10m5 11V4m5 17v-6',
          },
          {
            t: 'Compra por WhatsApp',
            d: `Armá tu carrito y enviá tu pedido directo a nuestro WhatsApp.`,
            i: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4-.85L3 20l1.85-5A7.9 7.9 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
          },
          {
            t: 'Atención y asesoramiento',
            d: 'Te ayudamos a elegir y coordinamos pago y envío como prefieras.',
            i: 'M17 20h5v-2a4 4 0 00-3-3.87m-8 5.87H4a4 4 0 00-4-4v-2a3 3 0 013-3h8a3 3 0 013 3v-.87M16 7a4 4 0 11-8 0 4 4 0 018 0z',
          },
        ].map((f) => (
          <div class="bg-slate-900 rounded-2xl p-6 border border-slate-800">
            <span class="w-11 h-11 rounded-xl bg-brand-600 text-white grid place-items-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={f.i} />
              </svg>
            </span>
            <h3 class="font-bold text-lg text-white">{f.t}</h3>
            <p class="mt-2 text-slate-400 text-sm leading-relaxed">{f.d}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- DESTACADOS -->
  <section class="bg-slate-900 border-y border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-14">
      <div class="flex items-end justify-between gap-4 mb-8">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Productos destacados</h2>
          <p class="text-slate-400 mt-1">Una selección de lo mejor de nuestro catálogo.</p>
        </div>
        <a
          href="/productos/"
          class="hidden sm:inline-flex items-center gap-1 font-semibold text-brand-400 hover:text-brand-300 transition"
        >
          Ver todos
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          otros.map((p) => (
            <ProductCard
              title={p.data.title}
              slug={p.id}
              precio={p.data.precio}
              imagen={p.data.imagen}
              categoria={cats.get(p.data.categoria) ?? p.data.categoria}
              subcategoria={p.data.subcategoria}
              destacado={p.data.destacado}
              stock={p.data.stock}
            />
          ))
        }
      </div>
      <div class="sm:hidden mt-6 text-center">
        <a
          href="/productos/"
          class="inline-flex items-center gap-1 font-semibold text-brand-400 hover:text-brand-300 transition"
        >
          Ver todos los productos
        </a>
      </div>
    </div>
  </section>

  <!-- SOBRE NOSOTROS -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
    <div class="grid lg:grid-cols-2 gap-10 items-center">
      <div class="relative">
        <img
          src="/images/logo.webp"
          alt="Catavio Sport"
          class="w-full aspect-[4/3] object-contain bg-black rounded-3xl shadow-lg p-6"
          loading="lazy"
        />
      </div>
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white">{sobreTitulo}</h2>
        {
          sobreTextos.map((parrafo) => (
            <p class="mt-4 text-slate-400 leading-relaxed">{parrafo}</p>
          ))
        }
        <ul class="mt-6 space-y-3">
          {
            sobreItems.map((item) => (
              <li class="flex items-start gap-3 text-slate-300">
                <span class="mt-0.5 w-5 h-5 rounded-full bg-brand-600 text-white grid place-items-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                {item}
              </li>
            ))
          }
        </ul>
        <a
          href="/contacto/"
          class="mt-8 inline-block px-6 py-3 rounded-lg bg-brand-600 hover:bg-brand-700 text-white font-semibold transition"
        >
          Contactanos
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const wrap = document.querySelector('[data-hero-carousel]');
  if (wrap) {
    const slides = [...wrap.querySelectorAll('[data-hero-slide]')];
    if (slides.length > 1) {
      const dots = [...document.querySelectorAll('[data-hero-dot]')];
      const prev = document.querySelector('[data-hero-prev]');
      const next = document.querySelector('[data-hero-next]');
      let current = 0;
      let timer: number | undefined;

      const go = (target: number) => {
        current = (target + slides.length) % slides.length;
        slides.forEach((s, i) => {
          const on = i === current;
          s.classList.toggle('opacity-100', on);
          s.classList.toggle('opacity-0', !on);
          s.classList.toggle('pointer-events-none', !on);
          s.toggleAttribute('inert', !on);
          s.setAttribute('aria-hidden', String(!on));
        });
        dots.forEach((d, i) => d.classList.toggle('bg-white', i === current));
        if (timer !== undefined) clearInterval(timer);
        timer = window.setInterval(() => go(current + 1), 6000);
      };

      prev?.addEventListener('click', () => go(current - 1));
      next?.addEventListener('click', () => go(current + 1));
      dots.forEach((d) =>
        d.addEventListener('click', () =>
          go(Number((d as HTMLElement).dataset.target))
        )
      );

      let touchStartX = 0;
      let touchStartY = 0;
      wrap.addEventListener(
        'touchstart' as 'pointerdown',
        (e: Event) => {
          const t = (e as TouchEvent).changedTouches[0];
          touchStartX = t.clientX;
          touchStartY = t.clientY;
        },
        { passive: true }
      );
      wrap.addEventListener(
        'touchend' as 'pointerdown',
        (e: Event) => {
          const t = (e as TouchEvent).changedTouches[0];
          const dx = t.clientX - touchStartX;
          const dy = t.clientY - touchStartY;
          if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) {
            go(dx < 0 ? current + 1 : current - 1);
          }
        },
        { passive: true }
      );

      timer = window.setInterval(() => go(current + 1), 6000);
    }
  }
</script>