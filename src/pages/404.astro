---
import BaseLayout from '../layouts/BaseLayout.astro';
---


<BaseLayout title="Página no encontrada">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-24 text-center">
    <p class="text-6xl font-extrabold text-brand-700">404</p>
    <h1 class="mt-4 text-3xl font-extrabold text-white">Página no encontrada</h1>
    <p class="mt-3 text-slate-400">
      La página que buscás no existe o fue movida.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="px-6 py-3 rounded-lg bg-brand-600 hover:bg-brand-700 text-white font-semibold transition"
      >
        Volver al inicio
      </a>
      <a
        href="/productos/"
        class="px-6 py-3 rounded-lg border border-slate-700 text-slate-200 font-semibold hover:bg-slate-800 transition"
      >
        Ver productos
      </a>
    </div>
  </section>
</BaseLayout>