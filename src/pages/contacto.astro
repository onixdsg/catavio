---
import BaseLayout from '../layouts/BaseLayout.astro';
import shop from '../data/shop.json';

const wa = shop.whatsapp?.replace(/[^\d]/g, '') ?? '';
---


<BaseLayout
  title="Contacto | Tienda"
  description="Contactanos por WhatsApp, email o acercate a nuestro local."
>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <div class="max-w-2xl mx-auto text-center mb-10">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Contacto</h1>
      <p class="mt-3 text-slate-500">
        Escribinos por WhatsApp, mandá un mail o acercate a nuestro local. Estamos para ayudarte.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 items-start">
      <!-- Formulario WhatsApp -->
      <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 mb-1">Enviar mensaje por WhatsApp</h2>
        <p class="text-sm text-slate-500 mb-6">
          Completá el formulario y tu mensaje se abrirá automáticamente en WhatsApp.
        </p>
        <form id="whatsapp-form" class="space-y-4">
          <div>
            <label for="wa-nombre" class="block text-sm font-medium text-slate-700 mb-1">Nombre *</label>
            <input
              id="wa-nombre"
              name="nombre"
              type="text"
              required
              placeholder="Tu nombre"
              class="w-full px-4 py-2.5 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500"
            />
          </div>
          <div>
            <label for="wa-telefono" class="block text-sm font-medium text-slate-700 mb-1">Teléfono</label>
            <input
              id="wa-telefono"
              name="telefono"
              type="tel"
              placeholder="Opcional"
              class="w-full px-4 py-2.5 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500"
            />
          </div>
          <div>
            <label for="wa-mensaje" class="block text-sm font-medium text-slate-700 mb-1">Mensaje *</label>
            <textarea
              id="wa-mensaje"
              name="mensaje"
              rows="4"
              required
              placeholder="Escribí tu consulta..."
              class="w-full px-4 py-2.5 border border-slate-200 rounded-lg resize-none focus:outline-none focus:ring-2 focus:ring-brand-500"
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-white font-semibold transition"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.04 2a9.9 9.9 0 00-8.43 15.06L2 22l5.08-1.57A9.92 9.92 0 1012.04 2z" />
            </svg>
            Enviar por WhatsApp
          </button>
        </form>
      </div>

      <!-- Datos de contacto -->
      <div class="space-y-6">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900 mb-4">Datos de la empresa</h2>
          <ul class="space-y-4 text-sm">
            <li class="flex gap-3">
              <span class="w-9 h-9 shrink-0 rounded-lg bg-brand-50 text-brand-600 grid place-items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </span>
              <div>
                <p class="text-slate-500">WhatsApp</p>
                <a
                  href={`https://wa.me/${wa}`}
                  target="_blank"
                  rel="noopener"
                  class="text-slate-800 font-medium hover:text-brand-600 transition"
                >
                  {shop.whatsapp}
                </a>
              </div>
            </li>
            {
              shop.email && (
                <li class="flex gap-3">
                  <span class="w-9 h-9 shrink-0 rounded-lg bg-brand-50 text-brand-600 grid place-items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </span>
                  <div>
                    <p class="text-slate-500">Email</p>
                    <a href={`mailto:${shop.email}`} class="text-slate-800 font-medium hover:text-brand-600 transition">
                      {shop.email}
                    </a>
                  </div>
                </li>
              )
            }
            {
              shop.domicilio && (
                <li class="flex gap-3">
                  <span class="w-9 h-9 shrink-0 rounded-lg bg-brand-50 text-brand-600 grid place-items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </span>
                  <div>
                    <p class="text-slate-500">Domicilio</p>
                    <p class="text-slate-800 font-medium">{shop.domicilio}</p>
                  </div>
                </li>
              )
            }
            {
              shop.horarios && (
                <li class="flex gap-3">
                  <span class="w-9 h-9 shrink-0 rounded-lg bg-brand-50 text-brand-600 grid place-items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                  <div>
                    <p class="text-slate-500">Horarios</p>
                    <p class="text-slate-800 font-medium">{shop.horarios}</p>
                  </div>
                </li>
              )
            }
          </ul>
        </div>

        <div class="bg-brand-50 border border-brand-100 rounded-2xl p-6">
          <p class="text-brand-700 font-medium text-sm">
            💡 Los pedidos, forma de pago y costos de envío se coordinan directamente por WhatsApp.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ wa }}>
    const form = document.getElementById('whatsapp-form');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const nombre = fd.get('nombre')?.toString().trim() || 'Sin nombre';
      const tel = fd.get('telefono')?.toString().trim() || '';
      const msg = fd.get('mensaje')?.toString().trim() || '';
      if (!msg) return;
      let text = `Hola, me comunico por la página web.`;
      text += `\n\nNombre: ${nombre}`;
      if (tel) text += `\nTeléfono: ${tel}`;
      text += `\n\n${msg}`;
      window.open(`https://wa.me/${wa}?text=${encodeURIComponent(text)}`, '_blank');
    });
  </script>
</BaseLayout>